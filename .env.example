# Variables de entorno de RedEduca (app web)
# Copiá este archivo como .env.local y completá los valores (.env.local no se sube a Git).

# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Supabase → Project Settings → API → clave "anon" (NUNCA la service_role)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# URL pública de la API, con https:// y sin / al final
NEXT_PUBLIC_API_URL=
